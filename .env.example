# Copie este arquivo para .env e preencha com sua chave real
# Obtenha sua chave gratuita em: https://console.groq.com/keys

GROQ_API_KEY=cole_sua_chave_aqui

# Opcional: URL do Ollama (padrão = http://localhost:11434)
# Se quiser usar Ollama em outra máquina (ex: desktop como servidor),
# coloque o IP da rede local: http://192.168.X.X:11434
OLLAMA_HOST=http://localhost:11434
